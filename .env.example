# 값을 채워 .env 로 복사한다. 기본값은 제공하지 않는다 —
# 공개 레포에 예시 키가 박히면 그 키로 만든 가명은 전부 역산 가능하다.
# 두 값 중 하나라도 비어 있으면 파이프라인은 기동을 거부한다.

# 결정적 가명 생성용 HMAC 시크릿 (32바이트 이상 랜덤)
#   python -c "import secrets; print(secrets.token_hex(32))"
KOPII_PSEUDONYM_SECRET=

# Vault(가역 경로) AES-GCM 키 — external_llm 프로파일에서만 사용
KOPII_VAULT_KEY=
